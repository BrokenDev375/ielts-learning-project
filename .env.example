# Configuration for a local coursework demo. Copy to .env before starting.
MYSQL_DATABASE=ielts_learning_orm
MYSQL_USER=ielts_app
MYSQL_PASSWORD=local-app-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
APP_PORT=5173
API_PORT=8080
MYSQL_PORT=3306
DEMO_ENABLED=true
DEMO_TEACHER_EMAIL=teacher@ielts.local
DEMO_TEACHER_PASSWORD=Teacher@12345
DEMO_STUDENT_EMAIL=student@ielts.local
DEMO_STUDENT_PASSWORD=Student@12345
SESSION_COOKIE_SECURE=false
